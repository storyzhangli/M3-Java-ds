{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/d25-knowledge-chunk.json",
  "title": "Knowledge Chunk metadata",
  "description": "D25 design contract. This is not a production database table.",
  "type": "object",
  "required": [
    "chunkId",
    "documentId",
    "documentVersion",
    "chunkGeneration",
    "chunkIndex",
    "text",
    "textSha256",
    "language",
    "parserVersion",
    "chunkerVersion",
    "indexVersion",
    "status",
    "permissionPolicyId",
    "documentPermissionVersion",
    "createdAt"
  ],
  "properties": {
    "chunkId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "documentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "chunkGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "chunkIndex": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "textSha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "sectionPath": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "pageStart": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "pageEnd": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "charStart": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "charEnd": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "sourceLocator": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "parserVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "chunkerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "indexVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "STALE", "FAILED", "DELETED"]
    },
    "permissionPolicyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "documentPermissionVersion": {
      "type": "integer",
      "minimum": 1
    },
    "visibilitySnapshot": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "RESTRICTED"]
    },
    "deviceModels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "faultCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "repairCategories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "tokenCount": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Only record when measured by the configured tokenizer."
    },
    "embedding": {
      "type": ["object", "null"],
      "required": ["model", "dimensions", "vectorRecordId", "status"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "dimensions": {"type": "integer", "minimum": 1},
        "vectorRecordId": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"type": "string", "enum": ["PENDING", "INDEXED", "FAILED", "STALE"]}
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "indexedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  },
  "additionalProperties": false
}
